{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uktl-meta-dashboard",
  "account_id": "1d7541992ccacf0931ee0e385daa5e08",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "uktl-meta-dashboard"
    }
  ],
  "vars": {
    "META_WRITES_ENABLED": "false",
    "META_RECENT_REFRESH_DAYS": "35",
    "HIGHLEVEL_SYNC_ENABLED": "false",
    "CUSTOMER_JOURNEY_SYNC_ENABLED": "true",
    "HIGHLEVEL_LEAD_FORM_ID": "aEwGU42vGjqNm43qwms7"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 5000
  },
  "triggers": {
    "crons": [
      "0 6 * * *",
      "30 6 * * *",
      "45 * * * *",
      "15 7 * * *"
    ]
  }
}
