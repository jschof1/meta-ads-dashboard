generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Legacy v1 tables are retained so a migration never silently discards data.
// The application no longer reads them; PR03 reads the durable model below.
model Snapshot {
  id            String   @id @default(cuid())
  capturedAt    DateTime @default(now())
  // window covered by this snapshot (e.g. last_30d)
  window        String
  spendCents    Int
  impressions   Int
  clicks        Int
  linkClicks    Int
  registrations Int
  callsBooked   Int
  enrollments   Int
  cprCents      Int?
  ctrLink       Float?
  cpmCents      Int?
  frequency     Float?
  raw           String   @default("{}")

  @@index([capturedAt])
}

// One row per ad per day, captured at every cron run (upsert by date+adId).
model AdDaily {
  id            String  @id @default(cuid())
  date          String
  adId          String
  adName        String
  status        String
  spendCents    Int
  impressions   Int
  linkClicks    Int
  ctrLink       Float
  registrations Int
  cprCents      Int?
  frequency     Float

  @@unique([date, adId])
  @@index([adId])
}

// Metadata is deliberately account-scoped by the Meta id. This is a single-
// business application, so there is no tenant or organisation abstraction.
model Campaign {
  id                  String   @id @default(cuid())
  metaId              String   @unique
  name                String
  objective           String?
  configuredStatus    String?
  effectiveStatus     String?
  dailyBudgetMinor    Int?
  lifetimeBudgetMinor Int?
  startDate           String?
  stopDate            String?
  providerUpdatedAt   DateTime?
  lastSeenSyncRunId   String?
  raw                 String   @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([effectiveStatus])
  @@index([lastSeenSyncRunId])
}

model AdSet {
  id                 String   @id @default(cuid())
  metaId             String   @unique
  campaignMetaId     String?
  name               String
  configuredStatus   String?
  effectiveStatus    String?
  optimisationGoal   String?
  billingEvent       String?
  dailyBudgetMinor  Int?
  lifetimeBudgetMinor Int?
  startDate          String?
  endDate            String?
  learningStage      String?
  learningStageInfo  String   @default("{}")
  providerUpdatedAt  DateTime?
  lastSeenSyncRunId  String?
  raw                String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([campaignMetaId])
  @@index([effectiveStatus])
  @@index([lastSeenSyncRunId])
}

model Ad {
  id               String   @id @default(cuid())
  metaId           String   @unique
  campaignMetaId   String?
  adSetMetaId      String?
  name             String
  configuredStatus String?
  effectiveStatus  String?
  creativeMetaId   String?
  providerUpdatedAt DateTime?
  lastSeenSyncRunId String?
  raw              String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([campaignMetaId])
  @@index([adSetMetaId])
  @@index([creativeMetaId])
  @@index([effectiveStatus])
  @@index([lastSeenSyncRunId])
}

model Creative {
  id                 String   @id @default(cuid())
  metaId             String   @unique
  name               String?
  title              String?
  body               String?
  callToActionType   String?
  thumbnailUrl       String?
  imageHash          String?
  imageUrl           String?
  videoId            String?
  objectId           String?
  destinationUrl     String?
  urlTags            String?
  format             String?
  providerUpdatedAt  DateTime?
  lastSeenSyncRunId  String?
  raw                String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([videoId])
  @@index([imageHash])
  @@index([lastSeenSyncRunId])
}

// One row per account/entity/day and attribution-window configuration. Every
// metric remains nullable: null means Meta omitted/failed to return the field,
// while zero means Meta returned an actual zero.
model DailyInsight {
  id                  String   @id @default(cuid())
  date                String
  level               String
  entityId            String
  attributionKey      String
  // "account" for account-wide syncs, or the configured Meta campaign id.
  // This prevents a scoped refresh from overwriting an account-wide row.
  scopeKey             String   @default("account")
  currencyCode        String?
  spendMinorUnits     Int?
  impressions         Int?
  reach               Int?
  clicks              Int?
  linkClicks          Int?
  leads               Int?
  cplMinorUnits       Int?
  cpcMinorUnits       Int?
  cpmMinorUnits       Int?
  ctrLink             Float?
  frequency           Float?
  resultActionType    String?
  rawActions          String   @default("[]")
  raw                 String   @default("{}")
  observedAt          DateTime @default(now())
  syncRunId           String

  @@unique([date, level, entityId, attributionKey, scopeKey])
  @@index([level, entityId, date])
  @@index([syncRunId])
}

// A run is both the audit record and the short-lived overlap lease. A non-null
// lockKey is unique, so concurrent manual/cron callers cannot write together.
// Expired RUNNING rows are safely marked failed and reclaimed by the next run.
model SyncRun {
  id                 String   @id @default(cuid())
  accountId          String
  campaignId         String?
  accountName        String?
  currencyCode       String?
  timezoneName       String?
  trigger            String
  status             String
  apiVersion         String?
  attributionKey     String
  requestedSince     String?
  requestedUntil     String?
  initialBackfill    Boolean  @default(false)
  startedAt          DateTime @default(now())
  finishedAt         DateTime?
  rowsFetched        Int      @default(0)
  rowsWritten        Int      @default(0)
  warning            String?
  error              String?
  traceId            String?
  // JSON-safe Meta response diagnostics; never includes the access token.
  apiDiagnostics     String?
  lockKey            String?  @unique
  lockOwner          String?
  lockExpiresAt      DateTime?

  aiBriefings AiBriefing[]

  @@index([accountId, status, finishedAt])
  @@index([accountId, startedAt])
}

// Deterministic analysis output. A fingerprint identifies one recommendation
// type for one target in one account/campaign/attribution scope; repeated syncs
// update that row instead of creating a new copy.
model Recommendation {
  id              String   @id @default(cuid())
  fingerprint     String   @unique
  accountId       String
  campaignId      String?
  attributionKey  String
  type            String
  analysisWindowDays Int
  ruleVersion     String   @default("pr06.v1")
  targetType      String
  targetId        String
  targetName      String
  severity        String
  confidence      String
  lifecycle       String   @default("OPEN")
  reason          String
  evidence        String   @default("{}")
  proposedAction  String
  sourceSyncRunId String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, campaignId, attributionKey, lifecycle])
  @@index([targetId, lastSeenAt])
  @@index([sourceSyncRunId])
}

// AI output is a durable, scoped snapshot of an explanation generated from
// stored evidence. The output and evidence are validated before they are
// written and validated again before they are exposed to the dashboard.
model AiBriefing {
  id              String   @id @default(cuid())
  kind            String
  accountId       String
  campaignId      String?
  attributionKey  String
  period          String
  dataHash        String
  output          String
  evidence        String   @default("[]")
  provider        String
  model           String
  sourceSyncRunId String
  snapshotKey     String   @unique
  generatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  sourceSyncRun SyncRun @relation(fields: [sourceSyncRunId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([kind, accountId, campaignId, attributionKey, generatedAt])
  @@index([dataHash])
  @@index([sourceSyncRunId])
}

// Read-only HighLevel snapshots. A sync writes a new audit row and points each
// normalized contact/opportunity at that row. Failed runs never replace the
// last successful snapshot, and provider payloads are deliberately not stored.
model CrmSyncRun {
  id                    String   @id @default(cuid())
  provider              String   @default("highlevel")
  locationId            String
  pipelineId            String
  apiVersion            String
  mappingHash           String
  status                String
  trigger               String
  startedAt             DateTime @default(now())
  finishedAt            DateTime?
  contactsFetched       Int      @default(0)
  opportunitiesFetched  Int      @default(0)
  contactsWritten       Int      @default(0)
  opportunitiesWritten  Int      @default(0)
  warning               String?
  error                 String?
  traceId               String?
  lockKey               String?  @unique
  lockOwner             String?
  lockExpiresAt         DateTime?

  contacts      CrmContact[]
  opportunities CrmOpportunity[]

  @@index([locationId, status, finishedAt])
  @@index([locationId, startedAt])
  @@index([locationId, mappingHash, status, finishedAt])
}

model CrmContact {
  id                     String   @id @default(cuid())
  highLevelId            String
  locationId             String
  dateAdded              String?
  dateUpdated            String?
  attributionGranularity String
  metaAdId               String?
  metaCampaignId         String?
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  utmContent             String?
  clickIds               String   @default("{}")
  attribution            String   @default("{}")
  sourceSyncRunId        String
  sourceSyncRun          CrmSyncRun @relation(fields: [sourceSyncRunId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([locationId, attributionGranularity])
  @@index([sourceSyncRunId])
  @@index([locationId, metaCampaignId])
  @@index([locationId, metaAdId])
  @@unique([locationId, highLevelId])
}

model CrmOpportunity {
  id                  String   @id @default(cuid())
  highLevelId         String
  locationId          String
  contactId           String?
  pipelineId          String
  pipelineStageId     String?
  status              String
  semanticStage       String?
  valueMajorUnits     Float?
  createdAtProvider   String?
  updatedAtProvider   String?
  lastStageChangeAt   String?
  lastStatusChangeAt  String?
  sourceSyncRunId     String
  sourceSyncRun       CrmSyncRun @relation(fields: [sourceSyncRunId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([locationId, contactId])
  @@index([pipelineId, semanticStage])
  @@index([sourceSyncRunId])
  @@unique([locationId, pipelineId, highLevelId])
}

// v2+ audit trail. Keep this model available for the approval-gated action
// work; PR03 does not create Meta mutations.
model ActionLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  action    String
  targetId  String
  reasoning String
  executor  String
  result    String?
}
