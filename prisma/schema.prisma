generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Legacy v1 tables are retained so a migration never silently discards data.
// The application no longer reads them; PR03 reads the durable model below.
model Snapshot {
  id            String   @id @default(cuid())
  capturedAt    DateTime @default(now())
  // window covered by this snapshot (e.g. last_30d)
  window        String
  spendCents    Int
  impressions   Int
  clicks        Int
  linkClicks    Int
  registrations Int
  callsBooked   Int
  enrollments   Int
  cprCents      Int?
  ctrLink       Float?
  cpmCents      Int?
  frequency     Float?
  raw           String   @default("{}")

  @@index([capturedAt])
}

// One row per ad per day, captured at every cron run (upsert by date+adId).
model AdDaily {
  id            String  @id @default(cuid())
  date          String
  adId          String
  adName        String
  status        String
  spendCents    Int
  impressions   Int
  linkClicks    Int
  ctrLink       Float
  registrations Int
  cprCents      Int?
  frequency     Float

  @@unique([date, adId])
  @@index([adId])
}

// Metadata is deliberately account-scoped by the Meta id. This is a single-
// business application, so there is no tenant or organisation abstraction.
model Campaign {
  id               String   @id @default(cuid())
  metaId           String   @unique
  name             String
  objective        String?
  configuredStatus String?
  effectiveStatus  String?
  startDate        String?
  stopDate         String?
  raw              String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([effectiveStatus])
}

model AdSet {
  id                 String   @id @default(cuid())
  metaId             String   @unique
  campaignMetaId     String?
  name               String
  configuredStatus   String?
  effectiveStatus    String?
  optimisationGoal   String?
  billingEvent       String?
  dailyBudgetMinor  Int?
  lifetimeBudgetMinor Int?
  startDate          String?
  endDate            String?
  learningStage      String?
  learningStageInfo  String   @default("{}")
  raw                String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([campaignMetaId])
  @@index([effectiveStatus])
}

model Ad {
  id               String   @id @default(cuid())
  metaId           String   @unique
  campaignMetaId   String?
  adSetMetaId      String?
  name             String
  configuredStatus String?
  effectiveStatus  String?
  creativeMetaId   String?
  raw              String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([campaignMetaId])
  @@index([adSetMetaId])
  @@index([creativeMetaId])
  @@index([effectiveStatus])
}

model Creative {
  id                 String   @id @default(cuid())
  metaId             String   @unique
  name               String?
  title              String?
  body               String?
  callToActionType   String?
  thumbnailUrl       String?
  imageHash          String?
  imageUrl           String?
  videoId            String?
  objectId           String?
  destinationUrl     String?
  urlTags            String?
  format             String?
  raw                String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([videoId])
  @@index([imageHash])
}

// One row per account/entity/day and attribution-window configuration. Every
// metric remains nullable: null means Meta omitted/failed to return the field,
// while zero means Meta returned an actual zero.
model DailyInsight {
  id                  String   @id @default(cuid())
  date                String
  level               String
  entityId            String
  attributionKey      String
  currencyCode        String?
  spendMinorUnits     Int?
  impressions         Int?
  reach               Int?
  clicks              Int?
  linkClicks          Int?
  leads               Int?
  cplMinorUnits       Int?
  cpcMinorUnits       Int?
  cpmMinorUnits       Int?
  ctrLink             Float?
  frequency           Float?
  resultActionType    String?
  rawActions          String   @default("[]")
  raw                 String   @default("{}")
  observedAt          DateTime @default(now())
  syncRunId           String

  @@unique([date, level, entityId, attributionKey])
  @@index([level, entityId, date])
  @@index([syncRunId])
}

// A run is both the audit record and the short-lived overlap lease. A non-null
// lockKey is unique, so concurrent manual/cron callers cannot write together.
// Expired RUNNING rows are safely marked failed and reclaimed by the next run.
model SyncRun {
  id                 String   @id @default(cuid())
  accountId          String
  accountName        String?
  currencyCode       String?
  timezoneName       String?
  trigger            String
  status             String
  apiVersion         String?
  attributionKey     String
  requestedSince     String?
  requestedUntil     String?
  initialBackfill    Boolean  @default(false)
  startedAt          DateTime @default(now())
  finishedAt         DateTime?
  rowsFetched        Int      @default(0)
  rowsWritten        Int      @default(0)
  warning            String?
  error              String?
  traceId            String?
  // JSON-safe Meta response diagnostics; never includes the access token.
  apiDiagnostics     String?
  lockKey            String?  @unique
  lockOwner          String?
  lockExpiresAt      DateTime?

  @@index([accountId, status, finishedAt])
  @@index([accountId, startedAt])
}

// v2+ audit trail. Keep this model available for the approval-gated action
// work; PR03 does not create Meta mutations.
model ActionLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  action    String
  targetId  String
  reasoning String
  executor  String
  result    String?
}
