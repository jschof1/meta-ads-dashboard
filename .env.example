# Authentication (required in every environment; use long, unique values)
DASHBOARD_PASSWORD=replace-with-a-strong-password
AUTH_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-different-random-secret

# Database (local development default)
DATABASE_URL=file:./dev.db
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Meta read access
META_MARKETING_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000000
META_GRAPH_VERSION=v25.0
META_CAMPAIGN_ID=
META_CUSTOM_CONVERSION_ID=
META_PRIMARY_RESULT_ACTION_TYPE=
META_ATTRIBUTION_WINDOWS=7d_click,1d_view
META_INITIAL_BACKFILL_DAYS=90
META_RECENT_REFRESH_DAYS=7
META_SYNC_LEASE_SECONDS=900
META_CAMPAIGN_LAUNCH_DATE=

# Optional AI briefing
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# HighLevel read-only CRM attribution. Leave disabled until the private
# integration, UKTL location, pipeline and every stage mapping are confirmed.
HIGHLEVEL_TOKEN=
HIGHLEVEL_LOCATION_ID=
HIGHLEVEL_API_VERSION=v3
HIGHLEVEL_SYNC_ENABLED=false
HIGHLEVEL_PIPELINE_ID=
HIGHLEVEL_STAGE_LEAD_ID=
HIGHLEVEL_STAGE_CONTACTED_ID=
HIGHLEVEL_STAGE_QUALIFIED_ID=
HIGHLEVEL_STAGE_CALL_BOOKED_ID=
HIGHLEVEL_STAGE_CALL_ATTENDED_ID=
HIGHLEVEL_WON_STATUS=
HIGHLEVEL_LOST_STATUS=
HIGHLEVEL_META_AD_ID_FIELD_ID=
HIGHLEVEL_META_CAMPAIGN_ID_FIELD_ID=
HIGHLEVEL_CURRENCY_CODE=
HIGHLEVEL_SYNC_LEASE_SECONDS=900
HIGHLEVEL_MAX_RECORDS=10000
